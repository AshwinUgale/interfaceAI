# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Discovery (LLM) run only. Not needed for deterministic replay. ---
# The exact model id is recorded into evidence at run time.
ANTHROPIC_API_KEY=
DISCOVERY_MODEL=claude-sonnet-4-5

# --- Target app ---
# TENANT selects which surface variant the target app serves (base | tenant-b).
TENANT=base
PORT=4000
